rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 읽기: 누구나 (학생용 공부 페이지 study.html이 로그인 없이 단어를 읽음)
    // 쓰기: 로그인한 사용자(학원 공용 계정)만
    match /books/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
